{
  "name": "@collabnode/example-solution-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:types": "collabnode types workspaces/solution-planner.yaml -o src/workspace.types.ts --name SolutionPlanner --check",
    "dev": "node --experimental-strip-types src/server.ts",
    "gen:types": "collabnode types workspaces/solution-planner.yaml -o src/workspace.types.ts --name SolutionPlanner",
    "predev": "npm run gen:types",
    "prestart": "npm run gen:types",
    "pretest": "npm run gen:types",
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types src/test.ts && node --experimental-strip-types src/test-architect-tools.ts",
    "test:llm": "node --experimental-strip-types src/test-llm-planner.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@collabnode/cli": "workspace:*",
    "@collabnode/deepagents": "workspace:*",
    "@collabnode/graph-view": "workspace:*",
    "@collabnode/react": "workspace:*",
    "@collabnode/redis": "workspace:*",
    "@collabnode/runtime": "workspace:*",
    "@collabnode/web": "workspace:*",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.5.10",
    "collabnode": "workspace:*",
    "deepagents": "^1.13.1",
    "dotenv": "^16.4.7",
    "ioredis": "^6.0.0",
    "langchain": "^1.5.10",
    "mermaid": "^11.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3"
  }
}
