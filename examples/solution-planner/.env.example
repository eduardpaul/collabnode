# Which provider to use: azure | openai | gemini.
# Leave unset to auto-detect in that order from whichever keys are present.
# When set, it wins — an ambient key for another provider is ignored.
# LLM_PROVIDER="azure"

# Azure OpenAI / Azure AI Foundry Configuration
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://testingfoundry1234x.services.ai.azure.com"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.6-luna"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# Or standard OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Or Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Port
PLANNER_PORT=4180

# Microsoft Learn MCP — used by the AI Architect while planning (public, no key).
# MICROSOFT_LEARN_MCP=0
# MICROSOFT_LEARN_MCP_URL="https://learn.microsoft.com/api/mcp"
