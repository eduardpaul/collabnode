# ---------------------------------------------------------------------------
# Azure Fluid Relay — the CRDT transport every peer connects to.
# Portal → your Fluid Relay resource → Access Information.
# ---------------------------------------------------------------------------
AZURE_FLUID_TENANT_ID=<tenant-guid>
AZURE_FLUID_ENDPOINT=https://<region>.fluidrelay.azure.com
# Primary or secondary key. Server-side only: it opens every document in the
# tenant, so it never reaches the browser. Browsers call /api/fluid/token.
AZURE_FLUID_KEY=<primary-or-secondary-key>

# ---------------------------------------------------------------------------
# Redis — the workspace registry, shared by every replica.
# Azure Managed Redis listens on 10000, Azure Cache for Redis on 6380; both
# require TLS, so the scheme is rediss:// and the access key is the password.
# ---------------------------------------------------------------------------
REDIS_URL=rediss://:<access-key>@<host>:10000
# Key namespace, so two deployments can share one Redis.
REDIS_PREFIX=voice-board

# ---------------------------------------------------------------------------
# Azure Voice Live over WebRTC — Microsoft Foundry resource
# https://learn.microsoft.com/azure/ai-services/speech-service/voice-live-webrtc
# Optional: without it the board works, the mic button does not.
# ---------------------------------------------------------------------------
AZURE_VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_VOICE_LIVE_API_KEY=
AZURE_VOICE_LIVE_MODEL=gpt-realtime
AZURE_VOICE_LIVE_API_VERSION=2026-01-01-preview

# Left unset on purpose: the voice follows the page language, so ?lang=es gets a
# Spanish speaker (es-ES-ElviraNeural) and English gets en-US-AvaNeural. Setting
# it here pins one voice for every language.
# AZURE_VOICE_LIVE_VOICE=en-US-AvaNeural

# Keyless alternative: leave AZURE_VOICE_LIVE_API_KEY empty and set a token
# generated for the https://ai.azure.com/.default scope, e.g.
#   az account get-access-token --scope https://ai.azure.com/.default --query accessToken -o tsv
# AZURE_VOICE_LIVE_TOKEN=

# Optional
VOICE_BOARD_PORT=4175
