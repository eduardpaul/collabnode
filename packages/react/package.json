{
  "name": "@collabnode/react",
  "version": "0.1.0",
  "type": "module",
  "description": "React hooks and context primitives for collabnode real-time collaborative state.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardpaul/collabnode.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/eduardpaul/collabnode/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/eduardpaul/collabnode/issues"
  },
  "keywords": [
    "collabnode",
    "react",
    "hooks",
    "crdt",
    "collaboration",
    "realtime"
  ],
  "exports": {
