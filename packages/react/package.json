  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/use-sync-external-store": "^0.0.6",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
