{
  "name": "collabnode",
  "version": "0.1.0",
  "type": "module",
  "description": "Collaborative graph runtime: YAML schema, pluggable CRDT, MCP, graph projection.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardpaul/collabnode.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/eduardpaul/collabnode#readme",
  "bugs": {
    "url": "https://github.com/eduardpaul/collabnode/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "collaboration",
    "crdt",
    "fluid",
    "graph",
    "hocuspocus",
    "loro",
    "mcp",
    "model-context-protocol",
    "realtime",
    "sharedtree",
    "yjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@collabnode/age": "workspace:*",
    "@collabnode/azure": "workspace:*",
    "@collabnode/collab": "workspace:*",
    "@collabnode/embeddings": "workspace:*",
    "@collabnode/fluid": "workspace:*",
    "@collabnode/graph": "workspace:*",
    "@collabnode/hocuspocus": "workspace:*",
    "@collabnode/hub": "workspace:*",
    "@collabnode/ladybug": "workspace:*",
    "@collabnode/loro": "workspace:*",
    "@collabnode/mcp": "workspace:*",
    "@collabnode/runtime": "workspace:*",
    "@collabnode/schema": "workspace:*"
  },
  "peerDependencies": {
    "@fluidframework/azure-client": "^2.40.0",
    "@ladybugdb/core": ">=0.11.0"
  },
  "peerDependenciesMeta": {
    "@fluidframework/azure-client": {
      "optional": true
    },
    "@ladybugdb/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
