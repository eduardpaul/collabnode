{
  "name": "@collabnode/loro",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@collabnode/collab": "workspace:*",
    "@collabnode/graph": "workspace:*",
    "@collabnode/schema": "workspace:*",
    "loro-crdt": "^1.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "description": "Loro collab backend for collabnode: DAG history, frontiers, and shallow-snapshot artifacts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardpaul/collabnode.git",
    "directory": "packages/loro"
  },
  "homepage": "https://github.com/eduardpaul/collabnode/tree/main/packages/loro#readme",
  "bugs": {
    "url": "https://github.com/eduardpaul/collabnode/issues"
  },
  "keywords": [
    "collabnode",
    "loro",
    "crdt",
    "version-control",
    "collaboration"
  ],
  "publishConfig": {
    "access": "public"
  }
}
